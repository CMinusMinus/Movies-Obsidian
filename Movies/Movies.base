filters:
  and:
    - file.hasTag("movie")
    - file.folder != "Templates"
formulas:
  Length: (file.properties['Length (min)']/60).floor() + 'h' + file.properties['Length (min)'] % 60 + 'm'
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("movie")
        - file.folder != "Templates"
    order:
      - file.name
      - Director
      - tags
      - formula.Length
  - type: cards
    name: Francis Ford Coppola
    filters:
      and:
        - Director == link("Francis Ford Coppola")
    order:
      - file.name
      - formula.Length
