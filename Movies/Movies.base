formulas:
  Length: (file.properties['Length (min)']/60).floor() + 'h' + file.properties['Length (min)']
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("movie")
        - file.folder != "Templates"
    order:
      - file.name
      - Director
      - Length
      - tags
