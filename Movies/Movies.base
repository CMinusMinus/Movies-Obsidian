filters:
  and:
    - file.hasTag("movie")
    - file.folder != "Templates"
formulas:
  Length: (file.properties['Length (min)']/60).floor() + 'h' + file.properties['Length (min)'] % 60 + 'm'
views:
  - type: cards
    name: All Movies
    filters:
      and:
        - file.hasTag("movie")
        - file.folder != "Templates"
    order:
      - file.name
      - Director
      - formula.Length
    image: note.Cover Image
    imageFit: contain
    cardSize: 620
  - type: cards
    name: Francis Ford Coppola
    filters:
      and:
        - Director == link("Francis Ford Coppola")
    order:
      - file.name
      - formula.Length
    image: note.Cover Image
    cardSize: 250
    imageFit: contain
  - type: table
    name: Director Template
    filters:
      and:
        - Director == link("Director Template")
  - type: table
    name: By Length
    order:
      - formula.Length
      - file.name
      - Director
      - Type
    sort:
      - property: Length (min)
        direction: ASC
  - type: cards
    name: Grouped By Type
    groupBy:
      property: Type
      direction: ASC
    order:
      - file.name
      - Director
      - formula.Length
    image: note.Cover Image
    imageFit: contain
    cardSize: 240
  - type: table
    name: By Director Whos File This is
    filters:
      and:
        - Director == this
